<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="easyONBOARDING · Handout-Studio" Width="1320" Height="900"
        MinWidth="1050" MinHeight="720" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}" FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F1F5F9"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#172554"/>
        <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569"/>
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#2563EB"/>
        <SolidColorBrush x:Key="NavBackgroundBrush" Color="#172554"/>
        <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="WarningBrush" Color="#92400E"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,4,0,4"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ReportEdButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ReportEdButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ReportEdButtonBorder" Property="BorderThickness" Value="2"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>
        <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="{DynamicResource NavBackgroundBrush}" Padding="22">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="easyONBOARDING" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource AccentForegroundBrush}"/>
                    <TextBlock Text="HANDOUT-STUDIO" FontSize="11" Margin="0,8,0,30" Foreground="{DynamicResource AccentForegroundBrush}"/>
                    <TextBlock Text="Vorlagenbibliothek" Foreground="{DynamicResource AccentForegroundBrush}" FontWeight="SemiBold" Margin="0,0,0,10"/>
                    <Button x:Name="ReportEdGermanButton" Content="Deutsch · Original" ToolTip="Ausgelieferte deutsche Vorlage laden"/>
                    <Button x:Name="ReportEdEnglishButton" Content="English · Original"/>
                    <Button x:Name="ReportEdNewButton" Content="+ Neues Handout"/>
                    <Button x:Name="ReportEdOpenButton" Content="Datei öffnen …"/>
                    <Button x:Name="ReportEdSaveButton" Content="Speichern unter …" Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,22,0,4"/>
                    <TextBlock Text="Strg+O · Öffnen&#10;Strg+N · Neu&#10;Strg+Umschalt+S · Speichern unter&#10;F5 · Vorschau" Foreground="{DynamicResource AccentForegroundBrush}" FontSize="11" Margin="0,20,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
                    <TextBlock Text="LOKAL &amp; OHNE VERBINDUNG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentForegroundBrush}"/>
                    <TextBlock Text="Keine AD-Daten. Keine Kennwörter. Nur erfundene Beispielwerte." Foreground="{DynamicResource AccentForegroundBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                </StackPanel>
                <Grid/>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,14">
                <TextBlock Text="Ein guter Start beginnt mit einem guten Handout." FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Style="{StaticResource CaptionTextStyle}" Text="Gestalte Willkommensdokumente und Übergabevorlagen. Technische Vorgangsberichte (HTML / JSON / CSV / TXT / PDF) entstehen unabhängig von diesen Vorlagen."/>
                <TextBlock x:Name="ReportEdFileLabel" Text="Neue Vorlage" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="01  Gestaltung" FontSize="16" FontWeight="SemiBold"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="80"/><ColumnDefinition Width="90"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,12,0"><TextBlock Text="Dokumenttitel"/><TextBox x:Name="ReportEdTitleInput" Text="{}{{ReportTitle}}" ToolTip="HTML-Titel; sichtbare Überschriften bleiben im Quelltext editierbar"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="Akzentfarbe"/><ComboBox x:Name="ReportEdAccentInput" IsEditable="True" ToolTip="Farbe auswählen oder #RRGGBB eingeben"><ComboBoxItem Content="#2563EB" IsSelected="True"/><ComboBoxItem Content="#0F766E"/><ComboBoxItem Content="#7C3AED"/><ComboBoxItem Content="#BE123C"/><ComboBoxItem Content="#334155"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="2" Margin="0,0,12,0"><TextBlock Text="Schrift"/><ComboBox x:Name="ReportEdFontInput"><ComboBoxItem Content="Segoe UI" IsSelected="True"/><ComboBoxItem Content="Arial"/><ComboBoxItem Content="Calibri"/><ComboBoxItem Content="Georgia"/></ComboBox></StackPanel>
                        <StackPanel Grid.Column="3" Margin="0,0,12,0"><TextBlock Text="Größe (pt)"/><TextBox x:Name="ReportEdSizeInput" Text="12"/></StackPanel>
                        <StackPanel Grid.Column="4"><TextBlock Text="Rand (px)"/><TextBox x:Name="ReportEdMarginInput" Text="24"/></StackPanel>
                    </Grid>
                    <DockPanel>
                        <Button x:Name="ReportEdStyleButton" Content="Gestaltung anwenden" DockPanel.Dock="Right"/>
                        <TextBlock Style="{StaticResource CaptionTextStyle}" Text="CSS wird als eigener Block ergänzt. Individuelle Inhalte bleiben erhalten. Quelltext hat Vorrang; Vorschau zeigt Text, kein HTML-Layout." VerticalAlignment="Center" Margin="0,0,16,0"/>
                    </DockPanel>
                </StackPanel>
            </Border>
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <TextBlock Text="02  Vorlagenquelltext" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <DockPanel Grid.Row="1">
                            <Button x:Name="ReportEdInsertButton" Content="Einfügen" DockPanel.Dock="Right" Margin="10,0,0,8"/>
                            <ComboBox x:Name="ReportEdPlaceholderInput" ToolTip="Unterstützten Platzhalter an der markierten Position einfügen"/>
                        </DockPanel>
                        <TextBox Grid.Row="2" x:Name="ReportEdSourceInput" AcceptsReturn="True" AcceptsTab="True" FontFamily="Consolas" FontSize="12"
                                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                                 SpellCheck.IsEnabled="False" AutomationProperties.Name="HTML-Vorlagenquelltext"/>
                    </Grid>
                </Border>
                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="{DynamicResource ControlBorderBrush}"/>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <DockPanel>
                            <Button x:Name="ReportEdPreviewButton" Content="Aktualisieren · F5" DockPanel.Dock="Right" Margin="10,0,0,8"/>
                            <TextBlock Text="03  Sichere Textvorschau" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Grid.Row="1" Style="{StaticResource CaptionTextStyle}" Text="Native WPF-Annäherung, nicht pixelgenau · nur erfundene Werte · keine Links, Bilder, Skripte oder externen Ressourcen. Kein Browser und keine Druck-/PDF-Vorschau."/>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <Border x:Name="ReportEdPreviewSheet">
                                <StackPanel>
                                    <Border x:Name="ReportEdPreviewAccent" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="4,0,0,0" Padding="14,8" Margin="0,8,0,18">
                                        <TextBlock x:Name="ReportEdPreviewTitle" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock x:Name="ReportEdPreviewText" FontSize="14" LineHeight="23" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </ScrollViewer>
                        <TextBox Grid.Row="3" x:Name="ReportEdWarningsText" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="125"
                                 VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource WarningBrush}" AutomationProperties.Name="Prüfhinweise"/>
                    </Grid>
                </Border>
            </Grid>
            <TextBlock Grid.Row="3" x:Name="ReportEdStatusLabel" Text="Bereit" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,12,0,0" TextWrapping="Wrap"/>
        </Grid>
    </Grid>
</Window>
